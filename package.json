{
  "name": "prosearc",
  "version": "1.3.0",
  "description": "A human-in-the-loop translation workspace for novels, powered by a local AI model.",
  "main": "main.js",
  "author": "ProseArc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FEzio78/ProseArc.git"
  },
  "keywords": [
    "translation",
    "novel",
    "localization",
    "electron",
    "offline",
    "llm",
    "lm-studio",
    "arabic",
    "rtl",
    "epub"
  ],
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/fetch-llama.js && electron-builder",
    "fetch-engine": "node scripts/fetch-llama.js"
  },
  "build": {
    "appId": "com.prosearc.app",
    "productName": "ProseArc",
    "files": [
      "**/*",
      "!dist/**",
      "!*.vbs",
      "!*.bat",
      "!*.pdf",
      "!sample-manuscript.txt",
      "!BUILD_BRIEF.md",
      "!vendor/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "FEzio78",
      "repo": "ProseArc"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ProseArc-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "shortcutName": "ProseArc",
      "artifactName": "ProseArc-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "vendor/llama",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "node-html-parser": "^8.0.1",
    "pdfjs-dist": "^6.1.200"
  }
}
